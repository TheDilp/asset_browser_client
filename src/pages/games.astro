---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameDashboard from '$lib/components/GameDashboard';
import { db } from '$lib/server/util/db';
import type { GameType } from '$lib/types/types';
import { getCurrentWorld } from '$lib/server/util/currentWorld';

if (!Astro.locals.user?.id) {
	return Astro.redirect('/login');
}

const games = await db
	.collection('games')
	.getFullList<GameType>({ filter: `owner_id = '${Astro.locals.user.id}' || owner_id = null` });

const currentWorld = await getCurrentWorld({
	serviceId: process.env.FOUNDRY_SERVICE_ID ?? import.meta.env.FOUNDRY_SERVICE_ID,
	token: process.env.COOLIFY_TOKEN ?? import.meta.env.COOLIFY_TOKEN
});
---

<BaseLayout title="Games">
	<GameDashboard client:load games={games} currentWorld={currentWorld} />
</BaseLayout>
